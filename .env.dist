# ── Anush Cuidarte Tools — variables de entorno (frontend Vite) ────────────
#
# Copiá este archivo a `.env` para desarrollo local:
#   cp .env.dist .env
# En producción (Cloudflare Pages) estas mismas variables se definen en
# Proyecto → Settings → Environment Variables (no se commitearn en el repo).
#
# Todas las variables empiezan con el prefijo VITE_ para que Vite las
# exponga al bundle en tiempo de build. Cambiar una de ellas en producción
# requiere reejecutar un deploy.

# URL base de la API (backend Django). Sin barra final.
#   Producción:    https://anush.com.ar/api   ← default
#   Dev local:     http://localhost:8000/api  ← descomentar para desarrollo
VITE_API_URL=https://anush.com.ar/api
# VITE_API_URL=http://localhost:8000/api

# Google Identity Services — Sign in with Google.
# OAuth 2.0 Client ID de tipo "Web application" de Google Cloud Console.
# Debe coincidir con GOOGLE_CLIENT_ID del backend.
VITE_GOOGLE_CLIENT_ID=